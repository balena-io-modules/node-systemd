{
	"compilerOptions": {
		"rootDir": "./",
		"outDir": "build",
		"noUnusedParameters": true,
		"noUnusedLocals": true,
		"removeComments": true,
		"sourceMap": true,
		"strict": true,
		"target": "es2025",
		"module": "commonjs",
		"esModuleInterop": true,
		"types": ["node", "mocha"],
		"declaration": true,
		"skipLibCheck": true
	},
	"ts-node": {
		"files": true
	},
	"include": [
		"lib/**/*.ts",
		"tests/**/*.ts",
		"typings/**/*.d.ts"
	]
}
